# LLM provider (OpenAI-compatible). OpenRouter with MiniMax M3 on its free
# tier - this is the exact configuration every published figure was measured
# on. Get a key at https://openrouter.ai/keys (looks like sk-or-v1-...).
#
# A paid frontier model is the largest available accuracy gain and needs no
# code change - only these three values. See README, "For real accuracy".
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=minimax/minimax-m3:free
LLM_API_KEY=

# Infrastructure (docker compose up -d)
DATABASE_URL=postgresql://analyst:analyst@localhost:7592/analyst_copilot
QDRANT_URL=http://localhost:7593

# Change this for any non-local deployment.
JWT_SECRET=dev-only-insecure-secret-override-with-JWT_SECRET-env-var
