# LLM provider (OpenAI-compatible). Groq by default - get a free key at
# https://console.groq.com -> API Keys.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Infrastructure (docker compose up -d)
DATABASE_URL=postgresql://analyst:analyst@localhost:5433/analyst_copilot
QDRANT_URL=http://localhost:6333

# Change this for any non-local deployment.
JWT_SECRET=dev-only-insecure-secret-override-with-JWT_SECRET-env-var
